# Clerk Configuration
# Get these from https://dashboard.clerk.com/~/api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key
CLERK_SECRET_KEY=sk_test_your-secret-key

# Neon (Postgres) — get from Vercel Storage tab or the Neon dashboard
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Vercel Blob — get from Vercel Storage tab, Blob store settings
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your-token

# OpenAI API (server-side only) — powers News article generation
# (gpt-5.6-luna for text, gpt-image-2-2026-04-21 for images) and the
# Wilson Weekly event extraction (text + vision, gpt-5.6-luna)
OPENAI_API_KEY=your-openai-api-key

# AgentMail (server-side only) — powers the nightly Wilson Weekly scan that
# pulls school newsletter dates into the Events page. Get an API key from
# https://www.agentmail.to
AGENTMAIL_API_KEY=your-agentmail-api-key
# The AgentMail inbox address to scan. Defaults to arorafam@agentmail.to if unset.
AGENTMAIL_INBOX_ID=your-inbox@agentmail.to

# Optional — protects /api/cron/expire from being triggered by anyone who
# guesses the URL. Vercel sends this automatically for its own Cron Jobs.
CRON_SECRET=
