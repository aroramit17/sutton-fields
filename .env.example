# Clerk Configuration
# Get these from https://dashboard.clerk.com/~/api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key
CLERK_SECRET_KEY=sk_test_your-secret-key

# Neon (Postgres) — get from Vercel Storage tab or the Neon dashboard
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Vercel Blob — get from Vercel Storage tab, Blob store settings
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your-token

# Google Gemini API (server-side only)
GEMINI_API_KEY=your-gemini-api-key

# Optional — protects /api/cron/expire from being triggered by anyone who
# guesses the URL. Vercel sends this automatically for its own Cron Jobs.
CRON_SECRET=
